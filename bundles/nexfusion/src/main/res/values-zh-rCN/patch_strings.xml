<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="patch_name_a_b_loop">A-B 循环播放</string>
    <string name="patch_desc_a_b_loop">添加选项，通过长按进度条设置循环起点和终点，循环播放歌曲片段。</string>
    <string name="patch_name_accessibility_layout">无障碍键盘布局</string>
    <string name="patch_desc_accessibility_layout">启用物理键盘模拟器和无障碍键盘布局模式。</string>
    <string name="patch_name_advanced_gemini_voice_typing">高级与 Gemini 语音输入</string>
    <string name="patch_desc_advanced_gemini_voice_typing">启用 Gemini Rambler 自然语音输入、NGA 统一语音听写堆栈及蓝牙麦克风设置。</string>
    <string name="patch_name_ai_writing_tools_flow_mode">AI 写作工具与流式模式</string>
    <string name="patch_desc_ai_writing_tools_flow_mode">为所有语言启用 AI 写作工具（校对、改写、智能编辑）和 llm_pc 流式模式按键。</string>
    <string name="patch_name_allow_screenshots">允许截屏与录屏</string>
    <string name="patch_desc_allow_screenshots">清除 FLAG_SECURE 标志，使截屏和录屏在所有页面（包括阅后即焚媒体）均可使用。</string>
    <string name="patch_name_always_show_compass">始终显示指南针</string>
    <string name="patch_desc_always_show_compass">在地图上永久显示指南针指针和方向指示，朝向正北时不再自动隐藏。</string>
    <string name="patch_name_always_show_hide">始终显示隐藏按钮</string>
    <string name="patch_desc_always_show_hide">添加选项，即使信息流帖子菜单被推荐选项替换，也始终显示“隐藏”按钮。</string>
    <string name="patch_name_ambient_mode">微光模式</string>
    <string name="patch_desc_ambient_mode">强制开启微光模式，并添加绕过省电限制的选项。</string>
    <string name="patch_name_amoled_black_theme">AMOLED 纯黑主题</string>
    <string name="patch_desc_amoled_black_theme">为 Google 地图深色模式界面元素应用纯正 AMOLED 黑色背景。</string>
    <string name="patch_name_amoled_dark_theme">AMOLED 纯黑主题</string>
    <string name="patch_desc_amoled_dark_theme">为 YouTube 界面元素、信息流、卡片、播放页和菜单应用纯黑（#000000）主题。播放视频时需在播放器设置（或微光模式补丁）中禁用微光模式以获得纯黑效果。</string>
    <string name="patch_name_android_auto">Android Auto 支持</string>
    <string name="patch_desc_android_auto">在 Android Auto 车载屏幕上启用 YouTube Music 集成与浏览功能。</string>
    <string name="patch_name_anonymous_profile_viewing">匿名查看个人资料</string>
    <string name="patch_desc_anonymous_profile_viewing">访问用户个人资料时不会出现在对方的“谁查看了我的资料”列表中。</string>
    <string name="patch_name_apple_music_artwork">Apple Music 动态封面</string>
    <string name="patch_desc_apple_music_artwork">将标准专辑封面替换为高分辨率动态 Apple Music 封面。</string>
    <string name="patch_name_auto_captions">自动字幕控制</string>
    <string name="patch_desc_auto_captions">添加选项，禁止视频自动开启字幕。</string>
    <string name="patch_name_autoplay_control">自动播放控制</string>
    <string name="patch_desc_autoplay_control">添加播放器按钮和下一视频规则：播放列表和队列继续播放，合辑在播放一定数量后停止，推荐视频永不自动播放。</string>
    <string name="patch_name_backup_restore_settings">备份与恢复设置</string>
    <string name="patch_desc_backup_restore_settings">启用 Gboard 个人词典、偏好设置和自定义主题的备份与恢复选项。</string>
    <string name="patch_name_block_automod_comments">屏蔽 AutoMod 置顶评论</string>
    <string name="patch_desc_block_automod_comments">隐藏评论区顶部来自 u/AutoModerator 的置顶和自动评论。</string>
    <string name="patch_name_block_popup_ads">屏蔽弹窗广告</string>
    <string name="patch_desc_block_popup_ads">屏蔽打开应用时显示的全屏推广弹窗（“Pendragon”消息）。</string>
    <string name="patch_name_block_screenshot_detection">阻止截屏检测</string>
    <string name="patch_desc_block_screenshot_detection">阻止 Instagram 在你截屏或录屏时向对方发送通知。</string>
    <string name="patch_name_block_telemetry_trackers">屏蔽遥测与追踪器</string>
    <string name="patch_desc_block_telemetry_trackers">重定向 Braze、Sentry、Google Ads、Crashlytics 和 Firebase Analytics 数据上报接口。</string>
    <string name="patch_name_block_tracking">屏蔽数据追踪</string>
    <string name="patch_desc_block_tracking">阻止发送大部分 LinkedIn 分析事件。与上游一致，默认关闭。</string>
    <string name="patch_name_block_update_screen">屏蔽更新提示界面</string>
    <string name="patch_desc_block_update_screen">屏蔽版本过旧提示页面，并阻止启动时弹出应用内更新提醒。</string>
    <string name="patch_name_bypass_image_region_restrictions">绕过图片地区限制</string>
    <string name="patch_desc_bypass_image_region_restrictions">添加选项，为用户头像和频道图片使用其他服务器域名。</string>
    <string name="patch_name_candidate_strip_emoji_vibrancy">候选栏表情高亮度显示</string>
    <string name="patch_desc_candidate_strip_emoji_vibrancy">确保候选栏中的表情符号以完全不透明（Alpha 255）渲染，并将推荐表情固定在右侧槽位。</string>
    <string name="patch_name_captions_in_picture_in_picture">画中画显示字幕</string>
    <string name="patch_desc_captions_in_picture_in_picture">添加选项，在画中画模式下显示视频字幕。</string>
    <string name="patch_name_change_start_page">更改启动页</string>
    <string name="patch_desc_change_start_page">添加选项，设置打开应用时默认进入的页面，替代主页。</string>
    <string name="patch_name_channel_search">频道内搜索</string>
    <string name="patch_desc_channel_search">添加选项，直接在当前打开的频道内搜索视频，而非全站搜索。</string>
    <string name="patch_name_channel_whitelist">频道白名单</string>
    <string name="patch_desc_channel_whitelist">添加选项，允许将特定频道加入白名单以显示广告或覆盖播放速度。</string>
    <string name="patch_name_collapse_all_comments">全部折叠评论</string>
    <string name="patch_desc_collapse_all_comments">添加选项，在帖子评论数旁显示按钮以一键折叠或展开所有评论。</string>
    <string name="patch_name_colorize_comment_indent_lines">彩色评论缩进线</string>
    <string name="patch_desc_colorize_comment_indent_lines">将默认的灰色评论缩进线替换为彩色层级线条。</string>
    <string name="patch_name_commandrouterhook">命令路由挂钩</string>
    <string name="patch_desc_commandrouterhook">挂钩各 Activity 的命令路由器，以便扩展程序执行命令。</string>
    <string name="patch_name_control_video_auto_scroll">控制视频自动滚动</string>
    <string name="patch_desc_control_video_auto_scroll">防止在沉浸式视图中自动滚动到下一个视频。</string>
    <string name="patch_name_conversioncontextpatch">转换上下文挂钩</string>
    <string name="patch_desc_conversioncontextpatch">挂钩转换上下文方法以供扩展程序使用。</string>
    <string name="patch_name_copy_text">复制文本</string>
    <string name="patch_desc_copy_text">长按帖子、评论或任意文本即可原地或通过底部面板选择并复制。</string>
    <string name="patch_name_copy_video_link">复制视频链接</string>
    <string name="patch_desc_copy_video_link">添加选项，在视频播放器中显示用于复制视频链接的按钮。</string>
    <string name="patch_name_cursor_trackpad">空格键光标触控板</string>
    <string name="patch_desc_cursor_trackpad">启用自由光标模式：在空格键上滑动即可移动文本光标。</string>
    <string name="patch_name_custom_seekbar_thumb">自定义进度条滑块</string>
    <string name="patch_desc_custom_seekbar_thumb">添加选项，使用自定义图片或动态 GIF 替换进度条滑块图标。</string>
    <string name="patch_name_custom_sharing_domain">自定义分享域名</string>
    <string name="patch_desc_custom_sharing_domain">将分享的 x.com 和 twitter.com 链接重写为 fxtwitter.com，以便在 Discord 和 Telegram 中富媒体预览视频和图片。</string>
    <string name="patch_name_customize_navigation_bar">自定义导航栏</string>
    <string name="patch_desc_customize_navigation_bar">移除选定的底部导航标签（人脉、发帖、通知、职位、视频、新闻），同时至少保留 3 个标签。</string>
    <string name="patch_name_dearrow">DeArrow 标题与缩略图</string>
    <string name="patch_desc_dearrow">添加选项，使用 DeArrow API 替换标题党视频缩略图和标题。</string>
    <string name="patch_name_developer_options_internal_flags">开发者选项与内部标志</string>
    <string name="patch_desc_developer_options_internal_flags">在 Gboard 设置中解锁内部开发者选项和实验性功能标志菜单。</string>
    <string name="patch_name_diagnose_spotify_client">Spotify 客户端诊断</string>
    <string name="patch_desc_diagnose_spotify_client">记录签名证书查询与完整性请求结果而不修改它们。</string>
    <string name="patch_name_direct_chat_bubbles">私信气泡通知</string>
    <string name="patch_desc_direct_chat_bubbles">允许 Instagram 私信通知以 Android 悬浮聊天气泡形式打开。</string>
    <string name="patch_name_disable_ad_breaks">禁用插播广告</string>
    <string name="patch_desc_disable_ad_breaks">禁用歌曲之间播放的广告时段（实验性）。</string>
    <string name="patch_name_disable_analytics">禁用数据分析</string>
    <string name="patch_desc_disable_analytics">停止向 Meta 发送使用报告、崩溃报告和日志事件。</string>
    <string name="patch_name_disable_audio_ducking">禁用音频闪避</string>
    <string name="patch_desc_disable_audio_ducking">防止 YouTube Music 在导航提示或系统通知触发时降低播放音量。</string>
    <string name="patch_name_disable_auto_captions">禁用自动字幕</string>
    <string name="patch_desc_disable_auto_captions">添加选项，防止视频自动启用字幕。</string>
    <string name="patch_name_disable_bottom_bar_auto_hide">禁用底栏自动隐藏</string>
    <string name="patch_desc_disable_bottom_bar_auto_hide">添加选项，在滚动浏览时保持底部导航栏始终可见。</string>
    <string name="patch_name_disable_chapter_skip_double_tap">禁用双指双击跳过章节</string>
    <string name="patch_desc_disable_chapter_skip_double_tap">添加选项，禁用双指双击跳过视频章节的手势。</string>
    <string name="patch_name_disable_dislike_redirection">禁用点踩切歌</string>
    <string name="patch_desc_disable_dislike_redirection">防止点击“不喜欢”按钮时自动跳转到下一首歌曲。</string>
    <string name="patch_name_disable_double_tap_like">禁用双击点赞</string>
    <string name="patch_desc_disable_double_tap_like">防止双击信息流帖子时触发点赞。</string>
    <string name="patch_name_disable_drc_audio">禁用 DRC 动态范围压缩</string>
    <string name="patch_desc_disable_drc_audio">添加选项，禁用 DRC 音频压缩与响度均衡。</string>
    <string name="patch_name_disable_immersive_player">禁用沉浸式播放器</string>
    <string name="patch_desc_disable_immersive_player">禁用探索页和时间线中的全屏上下滑动视频播放器。</string>
    <string name="patch_name_disable_in_app_update_checks">禁用应用内更新检查</string>
    <string name="patch_desc_disable_in_app_update_checks">屏蔽应用内更新弹窗和版本检查。</string>
    <string name="patch_name_disable_modern_home">禁用新版主页</string>
    <string name="patch_desc_disable_modern_home">在受支持的 Reddit 版本上禁用新版主页界面。</string>
    <string name="patch_name_disable_playlist_autoplay">禁用播放列表自动播放</string>
    <string name="patch_desc_disable_playlist_autoplay">添加选项，阻止播放列表自动播放下一个视频。</string>
    <string name="patch_name_disable_reddit_home_feed_auto_refresh">禁用 Reddit 主页自动刷新</string>
    <string name="patch_desc_disable_reddit_home_feed_auto_refresh">防止查看帖子或切出应用后主页信息流自动刷新。</string>
    <string name="patch_name_disable_reddit_home_screen_redirect">禁用 Reddit 主页跳转</string>
    <string name="patch_desc_disable_reddit_home_screen_redirect">阻止 Reddit 从后台恢复时自动跳转回主页。</string>
    <string name="patch_name_disable_reddit_screenshot_banner">禁用 Reddit 截屏横幅</string>
    <string name="patch_desc_disable_reddit_screenshot_banner">禁用截屏后弹出的分享提示横幅。</string>
    <string name="patch_name_disable_refresh_on_back_to_exit">禁用返回退出时刷新</string>
    <string name="patch_desc_disable_refresh_on_back_to_exit">添加选项，在主页按返回键直接退出应用，而不再先滚动到顶部并重新加载。</string>
    <string name="patch_name_disable_shorts_resuming_on_startup">禁用启动时恢复 Shorts</string>
    <string name="patch_desc_disable_shorts_resuming_on_startup">添加选项，防止上次观看 Shorts 后在启动应用时自动恢复 Shorts 页面。</string>
    <string name="patch_name_disable_ssl_pinning">禁用 SSL 证书固定</string>
    <string name="patch_desc_disable_ssl_pinning">绕过 Cloudflare API 调用的 OkHttp 证书固定，以允许 TLS 流量抓包。</string>
    <string name="patch_name_disable_telemetry">禁用遥测上报</string>
    <string name="patch_desc_disable_telemetry">禁用分析日志、Firebase 遥测及合规检查上报。</string>
    <string name="patch_name_disable_timeline_auto_refresh">禁用时间线自动刷新</string>
    <string name="patch_desc_disable_timeline_auto_refresh">阻止主页时间线自动刷新并跳回顶部，并在启动时保留浏览位置。</string>
    <string name="patch_name_disable_video_codecs">禁用视频编解码器</string>
    <string name="patch_desc_disable_video_codecs">添加选项，禁用或强制开启 HDR，以及禁用 VP9 编解码器。</string>
    <string name="patch_name_dm_debloat">精简私信界面</string>
    <string name="patch_desc_dm_debloat">隐藏私信对话中的通话按钮（禁用呼出私信通话）。</string>
    <string name="patch_name_don_t_save_recent_searches">不保存最近搜索</string>
    <string name="patch_desc_don_t_save_recent_searches">防止搜索记录被添加到最近搜索历史中。</string>
    <string name="patch_name_don_t_send_reel_watch_history">不上报 Reels 观看历史</string>
    <string name="patch_desc_don_t_send_reel_watch_history">阻止 Instagram 向服务器发送已观看的 Reels 状态，保护观看隐私。</string>
    <string name="patch_name_download_all_from_gallery">批量下载图集</string>
    <string name="patch_desc_download_all_from_gallery">添加选项，一次性下载图集帖子中的所有图片或视频。</string>
    <string name="patch_name_download_media">下载媒体</string>
    <string name="patch_desc_download_media">为帖子、Reels、快拍菜单及个人头像添加媒体下载按钮。</string>
    <string name="patch_name_downloads">下载功能</string>
    <string name="patch_desc_downloads">启用下载操作按钮和离线音频缓存。</string>
    <string name="patch_name_emoji_palette_v2_size_slider">新版表情面板与大小滑块</string>
    <string name="patch_desc_emoji_palette_v2_size_slider">启用带有常用/最近标签页的重新设计表情抽屉布局以及表情大小调节滑块。</string>
    <string name="patch_name_enable_dcim_folders_backup_control">启用 DCIM 文件夹备份控制</string>
    <string name="patch_desc_enable_dcim_folders_backup_control">禁用相机和其他 DCIM 文件夹的强制始终备份，允许自由控制备份开关。</string>
    <string name="patch_name_enable_debugging">启用调试日志</string>
    <string name="patch_desc_enable_debugging">添加调试选项并支持将 Morphe 日志导出到剪贴板。</string>
    <string name="patch_name_enable_exclusive_audio_playback">启用纯音频播放</string>
    <string name="patch_desc_enable_exclusive_audio_playback">启用仅播放音频而不加载视频画面的选项。</string>
    <string name="patch_name_enable_picture_in_picture">启用画中画</string>
    <string name="patch_desc_enable_picture_in_picture">启用 Crunchyroll 原生画中画模式，并支持跳过片头和片尾控制。</string>
    <string name="patch_name_enable_speedometer_speed_limits">启用车速表与限速提示</string>
    <string name="patch_desc_enable_speedometer_speed_limits">无视国家或地区限制，永久强制启用并显示实时驾驶车速表与限速指示。</string>
    <string name="patch_name_expand_posts">自动展开帖子</string>
    <string name="patch_desc_expand_posts">默认完整展开帖子内容，无需手动点击“查看更多”。</string>
    <string name="patch_name_extended_clipboard_screenshot_chips">扩展剪贴板与截图建议</string>
    <string name="patch_desc_extended_clipboard_screenshot_chips">启用 20,000 字符剪贴板上限、保留时长滑块（1小时、24小时、7天、30天、永久）及悬浮截图建议条。</string>
    <string name="patch_name_extensionhook">扩展程序挂钩</string>
    <string name="patch_name_feed_filters">信息流过滤器</string>
    <string name="patch_desc_feed_filters">过滤庆祝动态、招聘卡片、转发、视频、互动计数、AI 教练提示、益智游戏、推荐及新帖提示胶囊。</string>
    <string name="patch_name_filter_discover_ads">过滤 Discover 广告</string>
    <string name="patch_desc_filter_discover_ads">从 Google Discover 信息流中过滤推广广告卡片。</string>
    <string name="patch_name_fix_third_party_launchers_widgets">修复第三方桌面小组件</string>
    <string name="patch_desc_fix_third_party_launchers_widgets">允许将 Spotify 小组件添加到第三方桌面启动器。</string>
    <string name="patch_name_force_original_audio">强制使用原声音轨</string>
    <string name="patch_desc_force_original_audio">添加选项，始终使用视频原始音轨而非自动配音。</string>
    <string name="patch_name_force_system_font">强制使用系统字体</string>
    <string name="patch_desc_force_system_font">强制 Reddit 使用 Android 系统字体，替代内置自定义字体。</string>
    <string name="patch_name_force_zoom_buttons">强制显示缩放按钮</string>
    <string name="patch_desc_force_zoom_buttons">在地图界面永久显示专用放大/缩小（+/-）按钮，方便单手操作。</string>
    <string name="patch_name_full_screen_reply">全屏回复编辑器</string>
    <string name="patch_desc_full_screen_reply">点击回复评论时在全屏编辑器中打开，而非内联输入框。</string>
    <string name="patch_name_fullscreen_playlist_panel">全屏播放列表面板</string>
    <string name="patch_desc_fullscreen_playlist_panel">添加选项，在平板设备全屏播放器上方显示播放列表面板，而无需退出全屏。</string>
    <string name="patch_name_g_logo_on_spacebar">空格键显示 G 图标</string>
    <string name="patch_desc_g_logo_on_spacebar">在空格键上居中渲染 Google G 徽标。</string>
